{
  "name": "openclaw-telegram-usage-status",
  "version": "0.1.0",
  "description": "OpenClaw plugin that publishes 5h and weekly usage remaining in a Telegram bot profile.",
  "type": "module",
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run",
    "prepublish:check": "npm run plugin:validate && npm test && npm pack --dry-run"
  },
  "bin": {
    "telegram-usage-status": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openclaw",
    "telegram",
    "usage",
    "quota",
    "status",
    "plugin"
  ],
  "license": "MIT",
  "homepage": "https://docs.openclaw.ai/plugins/manage-plugins",
  "bugs": {
    "url": "https://docs.openclaw.ai/clawhub/troubleshooting"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.6"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "latest",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.6",
      "minGatewayVersion": "2026.6.6"
    },
    "build": {
      "openclawVersion": "2026.6.6",
      "pluginSdkVersion": "2026.6.6"
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-telegram-usage-status",
      "npmSpec": "openclaw-telegram-usage-status",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.6.6"
    }
  }
}
